# Garmin Connect Personal API key.
# Obtain in Garmin Connect web:  Settings > Account > Personal API Token.
# This is NOT your Garmin password; it is an opaque ApiKey string.
GARMIN_PERSONAL_API_KEY=

# Where to keep the local SQLite file.
# Defaults to ~/.fitness_mcp/data.db if unset.
# FITNESS_MCP_DB_PATH=/Users/you/.fitness_mcp/data.db

# Log verbosity: DEBUG, INFO, WARNING, ERROR. Logs go to stderr.
FITNESS_MCP_LOG_LEVEL=INFO

# HTTP timeout per upstream request (seconds).
FITNESS_MCP_HTTP_TIMEOUT=30

# Path to a custom CA bundle for upstream HTTPS calls. Set this when you're on a
# network with TLS inspection (e.g. Zscaler, Netskope) so Python trusts the
# interception root. On macOS, a quick recipe:
#   security find-certificate -a -c "Zscaler" -p /Library/Keychains/System.keychain > ~/.fitness_mcp/zscaler_ca.pem
#   CERTIFI=$(python -c 'import certifi; print(certifi.where())')
#   cat "$CERTIFI" ~/.fitness_mcp/zscaler_ca.pem > ~/.fitness_mcp/ca_bundle.pem
# FITNESS_MCP_CA_BUNDLE=/Users/you/.fitness_mcp/ca_bundle.pem

# Maximum days the server will accept in one tool call. Range is clamped silently
# and the response reports clamped=true if it was shortened.
FITNESS_MCP_MAX_RANGE_DAYS=90

# ---------------------------------------------------------------------------
# Transport.
#   stdio (default) — one process per MCP client, spawned by Claude Desktop/Code.
#   http            — long-running Streamable HTTP endpoint at FITNESS_MCP_HTTP_PATH.
# Also togglable at launch with `fitness-mcp --http`.
# ---------------------------------------------------------------------------
FITNESS_MCP_TRANSPORT=stdio

# Only read when transport=http.
FITNESS_MCP_HTTP_HOST=127.0.0.1
FITNESS_MCP_HTTP_PORT=8000
FITNESS_MCP_HTTP_PATH=/mcp

# Comma-separated allowed origins for CORS (claude.ai web needs this).
# Example: https://claude.ai,https://*.claude.ai
FITNESS_MCP_HTTP_CORS_ORIGINS=
